---
import tweets from "../data/tweets.json";
import TweetCard from "../components/TweetCard.astro";
import HugeIcon from "../components/HugeIcon.astro";
import {
  ArrowDown01Icon,
  ArrowLeft01Icon,
  ArrowRight01Icon,
  Bookmark02Icon,
  Cancel01Icon,
  CheckmarkBadge01Icon,
  Comment01Icon,
  FavouriteIcon,
  Home01Icon,
  InformationCircleIcon,
  Maximize03Icon,
  PlayCircle02Icon,
  RepeatIcon,
  Search01Icon,
  Share01Icon,
  ShuffleIcon,
  Sun03Icon,
  ThreadIcon,
  ViewIcon,
} from "@hugeicons/core-free-icons";
import "../styles/global.css";

const years = [...new Set(tweets.map((tweet) => new Date(tweet.createdAt).getFullYear()))].sort((a, b) => b - a);
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Feel The AGI: a living archive of the scaling era." />
    <meta name="theme-color" content="#080908" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Feel The AGI · The Scaling Era Archive</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      document.documentElement.dataset.theme = savedTheme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    </script>
  </head>
  <body data-base={base}>
    <main class="shell">
      <aside class="left-rail">
        <a class="brand" href={base} aria-label="Feel The AGI home"><span class="mark">⟋</span><span>FEEL<br />THE AGI</span></a>
        <nav aria-label="Archive navigation">
          <a class="active" href="#feed"><span><HugeIcon icon={Home01Icon} size={20} /></span> Archive</a>
          <a href="#about"><span><HugeIcon icon={InformationCircleIcon} size={20} /></span> Context</a>
          <a href="https://x.com" target="_blank" rel="noreferrer"><span><HugeIcon icon={Share01Icon} size={20} /></span> Original network</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme"><span class="theme-icon"><HugeIcon icon={Sun03Icon} size={20} /></span><span class="theme-label">Theme</span></button>
        <p class="rail-note">A hand-kept record of the moment when the future stopped arriving slowly.</p>
      </aside>

      <section class="timeline" id="feed">
        <header class="mobile-topbar">
          <a href={base} class="mobile-avatar" aria-label="Feel The AGI home">⟋</a>
          <div><strong>Feel The AGI</strong><span>{tweets.length.toLocaleString()} posts</span></div>
          <button class="theme-toggle mobile-theme-toggle" type="button" aria-label="Toggle color theme"><HugeIcon icon={Sun03Icon} size={20} /></button>
        </header>
        <header class="masthead">
          <div class="eyebrow"><span></span> FIELD NOTES · 2020—2026</div>
          <h1>Feel The<br /><em>AGI</em></h1>
          <p>Not a feed. A time capsule of technological acceleration, captured while it was still happening.</p>
          <div class="statline"><strong>{tweets.length.toLocaleString()}</strong> bookmarked fragments <span>·</span> reverse chronological</div>
        </header>
        <details class="mobile-context" id="about">
          <summary>About this archive</summary>
          <div><span>ABOUT THE COLLECTION</span><h2>Living through the winding-up of the world.</h2><p>AGI, robotics, medicine, China, labor, surveillance, drones, markets, and the odd little jokes people made when they felt the ground move.</p></div>
        </details>

        <div class="controls" aria-label="Archive controls">
          <div class="sort-tabs" role="group" aria-label="Sort archive">
            <button class="selected" data-sort="latest" aria-pressed="true">Latest first</button>
            <button data-sort="oldest" aria-pressed="false">Earliest</button>
            <button data-sort="random" aria-pressed="false"><HugeIcon icon={ShuffleIcon} size={14} /> Random</button>
          </div>
          <label class="search"><span><HugeIcon icon={Search01Icon} size={17} /></span><input id="search" type="search" placeholder="Search names, words, moments" aria-label="Search the archive" autocomplete="off" /></label>
        </div>
        <div class="year-strip" aria-label="Filter by year">
          <button class="selected" data-year="all" aria-pressed="true">All</button>
          {years.map((year) => <button data-year={year} aria-pressed="false">{year}</button>)}
        </div>
        <div class="result-bar"><p class="result-count" id="result-count" aria-live="polite">Showing 30 of {tweets.length.toLocaleString()} artifacts</p><button id="clear-filters" hidden>Clear filters</button></div>
        <div id="tweet-list" data-total={tweets.length}>
          {tweets.slice(0, 30).map((tweet) => <div data-date={tweet.createdAt} data-year={new Date(tweet.createdAt).getFullYear()}><TweetCard tweet={tweet} /></div>)}
        </div>
        <div class="load-zone"><button id="load-more">Load 30 more <HugeIcon icon={ArrowDown01Icon} size={16} /></button></div>
      </section>

      <aside class="right-rail">
        <div class="placard">
          <span class="placard-number">EXHIBIT 01</span>
          <h2>Living through the winding-up of the world.</h2>
          <p>AGI, robotics, medicine, China, labor, surveillance, drones, markets, and the odd little jokes people made when they felt the ground move.</p>
        </div>
        <dl class="collection-stats">
          <div><dt>{tweets.length.toLocaleString()}</dt><dd>artifacts</dd></div>
          <div><dt>{years.length}</dt><dd>years</dd></div>
          <div><dt>1</dt><dd>uncertain future</dd></div>
        </dl>
        <div class="legend">
          <span>READING MODE</span>
          <p><b>Latest</b> keeps the original reverse chronology. <b>Randomize</b> lets distant moments collide.</p>
        </div>
        <p class="source-note">Tweets retain their original attribution and link back to X. Counts are captured from the archive, not live.</p>
      </aside>
    </main>
    <dialog class="lightbox" id="media-lightbox" aria-label="Media viewer">
      <div class="lightbox-toolbar"><span id="lightbox-count" aria-live="polite"></span><button id="lightbox-close" type="button" aria-label="Close media viewer"><HugeIcon icon={Cancel01Icon} size={24} /></button></div>
      <button class="lightbox-nav lightbox-prev" id="lightbox-prev" type="button" aria-label="Previous media"><HugeIcon icon={ArrowLeft01Icon} size={28} /></button>
      <figure><img id="lightbox-image" alt="" /><video id="lightbox-video" controls playsinline hidden></video><figcaption id="lightbox-caption"></figcaption></figure>
      <button class="lightbox-nav lightbox-next" id="lightbox-next" type="button" aria-label="Next media"><HugeIcon icon={ArrowRight01Icon} size={28} /></button>
    </dialog>
    <div class="icon-templates" aria-hidden="true">
      <template id="icon-comment"><HugeIcon icon={Comment01Icon} size={18} /></template>
      <template id="icon-repeat"><HugeIcon icon={RepeatIcon} size={18} /></template>
      <template id="icon-favourite"><HugeIcon icon={FavouriteIcon} size={18} /></template>
      <template id="icon-bookmark"><HugeIcon icon={Bookmark02Icon} size={18} /></template>
      <template id="icon-share"><HugeIcon icon={Share01Icon} size={18} /></template>
      <template id="icon-play"><HugeIcon icon={PlayCircle02Icon} size={42} /></template>
      <template id="icon-maximize"><HugeIcon icon={Maximize03Icon} size={18} /></template>
      <template id="icon-verified"><HugeIcon icon={CheckmarkBadge01Icon} size={15} /></template>
      <template id="icon-thread"><HugeIcon icon={ThreadIcon} size={15} /></template>
      <template id="icon-view"><HugeIcon icon={ViewIcon} size={18} /></template>
    </div>
    <script is:inline>
      const list = document.querySelector('#tweet-list');
      const sortButtons = [...document.querySelectorAll('[data-sort]')];
      const yearButtons = [...document.querySelectorAll('[data-year]')];
      const search = document.querySelector('#search');
      const count = document.querySelector('#result-count');
      const clearFilters = document.querySelector('#clear-filters');
      const loadMore = document.querySelector('#load-more');
      const themeToggles = [...document.querySelectorAll('.theme-toggle')];
      const baseUrl = document.body.dataset.base || '/';
      const lightbox = document.querySelector('#media-lightbox');
      const lightboxImage = document.querySelector('#lightbox-image');
      const lightboxVideo = document.querySelector('#lightbox-video');
      const lightboxCount = document.querySelector('#lightbox-count');
      const lightboxClose = document.querySelector('#lightbox-close');
      const lightboxPrev = document.querySelector('#lightbox-prev');
      const lightboxNext = document.querySelector('#lightbox-next');
      let selectedYear = 'all';
      let shown = 30;
      let archive = null;
      let archivePromise = null;
      let ordered = null;
      let activeSort = 'latest';
      let loadingMore = false;
      let lightboxItems = [];
      let lightboxIndex = 0;
      let renderedCount = 30;
      let lastRenderKey = 'latest|all|';
      let videoObserver;
      const icon = (name) => document.querySelector(`#icon-${name}`).innerHTML;
      const formatCount = (value = 0) => value ? Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(value) : '';
      const escapeHtml = (value = '') => value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
      const safeUrl = (value = '') => /^https?:\/\//.test(value) || value.startsWith('data:image/') || (value.startsWith('/') && !value.startsWith('//')) ? value : '#';
      const linkify = (text, urls = [], hasMedia = false) => {
        const map = new Map(urls.filter((item) => item.url).map((item) => [item.url, item]));
        const pattern = /(https?:\/\/\S+|@[A-Za-z0-9_]+|#[\p{L}\p{N}_]+)/gu;
        let output = '', cursor = 0;
        for (const match of text.matchAll(pattern)) {
          output += escapeHtml(text.slice(cursor, match.index));
          const value = match[0];
          if (value.startsWith('http')) {
            const entity = map.get(value);
            const hidden = hasMedia && value.startsWith('https://t.co/') && !text.slice(match.index + value.length).trim();
            if (!hidden) output += `<a class="inline-link" href="${escapeHtml(safeUrl(entity?.expandedUrl || value))}" target="_blank" rel="noreferrer">${escapeHtml(entity?.displayUrl || value.replace(/^https?:\/\//, ''))}</a>`;
          } else {
            const href = value.startsWith('@') ? `https://x.com/${value.slice(1)}` : `https://x.com/hashtag/${encodeURIComponent(value.slice(1))}`;
            output += `<a class="inline-link" href="${href}" target="_blank" rel="noreferrer">${escapeHtml(value)}</a>`;
          }
          cursor = match.index + value.length;
        }
        return output + escapeHtml(text.slice(cursor));
      };
      const gallery = (media = [], quote = false, group = '', author = '', sourceUrl = '') => media.length ? `<div class="${quote ? 'quote-media' : 'media'} media-count-${media.length}${media.length > 1 ? ' media-grid' : ''}" data-media-group="${escapeHtml(group)}">${media.slice(0, 4).map((item, index) => {
        const video = [...(item.variants || [])].filter((variant) => variant.contentType === 'video/mp4' || variant.url.includes('.mp4')).sort((a, b) => (b.bitRate || 0) - (a.bitRate || 0))[0];
        if (video) return `<div class="video-frame"><video class="tweet-video" data-src="${escapeHtml(safeUrl(video.url))}" poster="${escapeHtml(safeUrl(item.thumbnailUrl || item.url))}" muted playsinline controls preload="none"></video><button class="video-lightbox-trigger" type="button" data-video-url="${escapeHtml(safeUrl(video.url))}" data-video-poster="${escapeHtml(safeUrl(item.thumbnailUrl || item.url))}" data-media-label="${escapeHtml(`${author}, ${quote ? 'quoted ' : ''}video ${index + 1}`)}" aria-label="Open video in media viewer">${icon('maximize')}</button></div>`;
        if (item.type === 'video' || item.type === 'gif' || /(?:amplify_)?video_thumb/.test(item.url)) return `<a class="media-trigger video-preview" href="${escapeHtml(safeUrl(sourceUrl))}" target="_blank" rel="noreferrer" aria-label="Play video on X"><img src="${escapeHtml(safeUrl(item.url))}" alt="" loading="lazy" decoding="async"><span class="play-badge">${icon('play')}</span></a>`;
        return `<button class="media-trigger" type="button" data-media-url="${escapeHtml(safeUrl(item.url))}" data-media-index="${index}" data-media-label="${escapeHtml(`${author}, ${quote ? 'quoted ' : ''}image ${index + 1} of ${media.length}`)}" aria-label="Open image ${index + 1} of ${media.length}"><img src="${escapeHtml(safeUrl(item.url))}" alt="" loading="lazy" decoding="async"></button>`;
      }).join('')}</div>` : '';
      const renderTweet = (tweet) => {
        const date = new Date(tweet.createdAt);
        const xUrl = `https://x.com/${encodeURIComponent(tweet.author.handle)}/status/${tweet.id}`;
        const media = (tweet.media || []).slice(0, 4);
        const quoteMedia = (tweet.quote?.media || []).slice(0, 4);
        const long = tweet.text.length > 700;
        const quoteLong = (tweet.quote?.text.length || 0) > 500;
        const avatar = tweet.author.avatarUrl ? `<img src="${escapeHtml(safeUrl(tweet.author.avatarUrl))}" alt="">` : escapeHtml(tweet.author.displayName.trim().slice(0, 2).toUpperCase());
        const verified = tweet.author.verified ? `<span class="verified" aria-label="Verified account">${icon('verified')}</span>` : '';
        const thread = tweet.thread ? `<a class="thread-label" href="${xUrl}" target="_blank" rel="noreferrer">${icon('thread')} Post ${tweet.thread.position} of ${tweet.thread.total} in this author's thread</a>` : '';
        const replying = tweet.replyToId ? `<p class="replying">Replying to ${tweet.replyToHandle ? `<a href="https://x.com/${encodeURIComponent(tweet.replyToHandle)}" target="_blank" rel="noreferrer">@${escapeHtml(tweet.replyToHandle)}</a>` : 'another post'}</p>` : '';
        const parent = tweet.replyContext ? `<div class="reply-parent"><a class="reply-parent-header" href="https://x.com/${encodeURIComponent(tweet.replyContext.author.handle)}/status/${escapeHtml(String(tweet.replyContext.id))}" target="_blank" rel="noreferrer"><span class="reply-parent-avatar">${tweet.replyContext.author.avatarUrl ? `<img src="${escapeHtml(safeUrl(tweet.replyContext.author.avatarUrl))}" alt="">` : escapeHtml(tweet.replyContext.author.displayName.slice(0, 2).toUpperCase())}</span><b>${escapeHtml(tweet.replyContext.author.displayName)}</b>${tweet.replyContext.author.verified ? icon('verified') : ''}<span>@${escapeHtml(tweet.replyContext.author.handle)}</span></a><p>${linkify(tweet.replyContext.text)}</p>${tweet.replyContext.media?.[0] ? `<img class="reply-parent-media" src="${escapeHtml(safeUrl(tweet.replyContext.media[0].thumbnailUrl || tweet.replyContext.media[0].url))}" alt="" loading="lazy">` : ''}</div>` : '';
        const quoteUrl = tweet.quote ? `https://x.com/${encodeURIComponent(tweet.quote.author.handle)}/status/${escapeHtml(String(tweet.quote.id))}` : '';
        const quoteAvatar = tweet.quote?.author.avatarUrl ? `<img src="${escapeHtml(safeUrl(tweet.quote.author.avatarUrl))}" alt="">` : '';
        const quote = tweet.quote ? `<div class="quote"><div class="quote-header">${quoteAvatar}<a class="quote-source" href="${quoteUrl}" target="_blank" rel="noreferrer"><b>${escapeHtml(tweet.quote.author.displayName)}</b>${tweet.quote.author.verified ? icon('verified') : ''}<span>@${escapeHtml(tweet.quote.author.handle)}</span></a></div><div class="quote-copy${quoteLong ? ' collapsed' : ''}"><p>${linkify(tweet.quote.text, tweet.quote.urls || [], quoteMedia.length > 0)}</p></div>${quoteLong ? `<a class="quote-more" href="${quoteUrl}" target="_blank" rel="noreferrer">Read full quoted post ↗</a>` : ''}${gallery(quoteMedia, true, `quote-${tweet.quote.id}`, tweet.quote.author.displayName, quoteUrl)}</div>` : '';
        const metrics = tweet.metrics || {};
        const secondary = metrics.quoteCount || metrics.bookmarkCount ? `<div class="secondary-metrics">${metrics.quoteCount ? `<span>${Number(metrics.quoteCount).toLocaleString()} quotes</span>` : ''}${metrics.bookmarkCount ? `<span>${Number(metrics.bookmarkCount).toLocaleString()} bookmarks</span>` : ''}</div>` : '';
        return `<article class="tweet"><div class="avatar" style="--hue:${Number(tweet.author.avatarHue) || 220}">${avatar}</div><div class="tweet-body"><header class="tweet-header"><span class="name">${escapeHtml(tweet.author.displayName)}</span>${verified}<a class="handle" href="https://x.com/${encodeURIComponent(tweet.author.handle)}" target="_blank" rel="noreferrer">@${escapeHtml(tweet.author.handle)}</a><span class="dot">·</span><time datetime="${escapeHtml(tweet.createdAt)}" title="${escapeHtml(date.toLocaleString())}">${date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time><a class="tweet-menu" href="${xUrl}" target="_blank" rel="noreferrer" aria-label="Open original tweet">•••</a></header>${thread}${replying}${parent}<div class="tweet-copy${long ? ' collapsed' : ''}"><p class="tweet-text">${linkify(tweet.text, tweet.urls, media.length > 0)}</p></div>${long ? '<button class="expand-copy" type="button" aria-expanded="false">Show more</button>' : ''}${gallery(media, false, tweet.id, tweet.author.displayName, xUrl)}${quote}<footer class="tweet-actions"><a class="action" href="${xUrl}" target="_blank" rel="noreferrer" aria-label="${metrics.replyCount || 0} replies">${icon('comment')}<small>${formatCount(metrics.replyCount)}</small></a><span class="action" aria-label="${metrics.repostCount || 0} reposts">${icon('repeat')}<small>${formatCount(metrics.repostCount)}</small></span><span class="action like" aria-label="${Number(tweet.likeCount).toLocaleString()} likes">${icon('favourite')}<small>${formatCount(tweet.likeCount)}</small></span><span class="action views" aria-label="${metrics.viewCount || 0} views">${icon('view')}<small>${formatCount(metrics.viewCount)}</small></span><span class="action" aria-hidden="true">${icon('bookmark')}</span><a class="action" href="${xUrl}" target="_blank" rel="noreferrer" aria-label="Open original tweet">${icon('share')}</a></footer>${secondary}</div></article>`;
      };
      const ensureArchive = async () => {
        if (archive) return;
        if (!archivePromise) archivePromise = fetch(`${baseUrl}tweets.json`).then((response) => {
          if (!response.ok) throw new Error(`Archive request failed: ${response.status}`);
          return response.json();
        }).then((data) => {
          archive = data;
          ordered = [...data];
        }).catch((error) => {
          archivePromise = null;
          throw error;
        });
        await archivePromise;
      };
      const fisherYates = (items) => {
        const result = [...items];
        for (let index = result.length - 1; index > 0; index--) {
          const swap = Math.floor(Math.random() * (index + 1));
          [result[index], result[swap]] = [result[swap], result[index]];
        }
        return result;
      };
      const applyFilters = async (append = false) => {
        try {
          await ensureArchive();
        } catch (error) {
          count.textContent = 'Could not load the archive. Try again.';
          loadMore.hidden = false;
          return false;
        }
        const query = search.value.trim().toLowerCase();
        const matches = ordered.filter((tweet) => {
          const matchesYear = selectedYear === 'all' || String(new Date(tweet.createdAt).getFullYear()) === selectedYear;
          const haystack = `${tweet.author.displayName} ${tweet.author.handle} ${tweet.text} ${tweet.quote?.author?.displayName || ''} ${tweet.quote?.author?.handle || ''} ${tweet.quote?.text || ''}`.toLowerCase();
          return matchesYear && (!query || haystack.includes(query));
        });
        const visible = matches.slice(0, shown);
        const renderKey = `${activeSort}|${selectedYear}|${query}`;
        const canAppend = append && renderKey === lastRenderKey && renderedCount < visible.length;
        const renderItems = canAppend ? visible.slice(renderedCount) : visible;
        const html = renderItems.map((tweet) => `<div data-date="${escapeHtml(tweet.createdAt)}" data-year="${new Date(tweet.createdAt).getFullYear()}">${renderTweet(tweet)}</div>`).join('');
        if (canAppend) list.insertAdjacentHTML('beforeend', html); else list.innerHTML = html;
        observeVideos(list);
        renderedCount = visible.length;
        lastRenderKey = renderKey;
        count.textContent = `Showing ${visible.length.toLocaleString()} of ${matches.length.toLocaleString()} artifact${matches.length === 1 ? '' : 's'}`;
        clearFilters.hidden = selectedYear === 'all' && !query;
        loadMore.hidden = visible.length >= matches.length;
        return true;
      };
      sortButtons.forEach((button) => button.addEventListener('click', async () => {
        await ensureArchive();
        activeSort = button.dataset.sort;
        sortButtons.forEach((item) => item.classList.toggle('selected', item === button));
        sortButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        ordered = activeSort === 'random' ? fisherYates(archive) : [...archive].sort((a, b) => activeSort === 'latest' ? b.createdAt.localeCompare(a.createdAt) : a.createdAt.localeCompare(b.createdAt));
        shown = 30;
        await applyFilters();
        window.scrollTo({ top: document.querySelector('.controls').offsetTop, behavior: 'smooth' });
      }));
      yearButtons.forEach((button) => button.addEventListener('click', async () => {
        selectedYear = button.dataset.year;
        shown = 30;
        yearButtons.forEach((item) => item.classList.toggle('selected', item === button));
        yearButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        await applyFilters();
      }));
      let searchTimer;
      search.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { shown = 30; applyFilters(); }, 120); });
      clearFilters.addEventListener('click', async () => {
        selectedYear = 'all'; search.value = '';
        yearButtons.forEach((item) => item.classList.toggle('selected', item.dataset.year === 'all'));
        yearButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.year === 'all')));
        shown = 30;
        await applyFilters();
      });
      list.addEventListener('click', (event) => {
        const button = event.target.closest('.expand-copy');
        if (!button) return;
        const copy = button.previousElementSibling;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        copy.classList.toggle('collapsed', expanded);
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? 'Show more' : 'Show less';
      });
      const loadNextPage = async () => {
        if (loadingMore || loadMore.hidden) return;
        loadingMore = true;
        const previousShown = shown;
        shown += 30;
        try {
          const loaded = await applyFilters(true);
          if (!loaded) shown = previousShown;
        } finally {
          loadingMore = false;
        }
      };
      loadMore.addEventListener('click', loadNextPage);
      const infiniteObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadNextPage();
      }, { rootMargin: '700px 0px' });
      infiniteObserver.observe(document.querySelector('.load-zone'));
      const observeVideos = (container) => container.querySelectorAll('.tweet-video').forEach((video) => videoObserver?.observe(video));
      videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) {
            if (!video.src && video.dataset.src) {
              video.src = video.dataset.src;
              video.load();
            }
            video.play().catch(() => {});
          } else {
            video.pause();
            video.removeAttribute('src');
            video.load();
          }
        });
      }, { threshold: .55, rootMargin: '120px 0px' });
      observeVideos(document);
      const updateLightbox = () => {
        const item = lightboxItems[lightboxIndex];
        if (!item) return;
        const videoUrl = item.dataset.videoUrl;
        if (videoUrl) {
          lightboxImage.hidden = true;
          lightboxVideo.hidden = false;
          lightboxVideo.poster = item.dataset.videoPoster || '';
          lightboxVideo.src = videoUrl;
          lightboxVideo.play().catch(() => {});
        } else {
          lightboxVideo.pause();
          lightboxVideo.removeAttribute('src');
          lightboxVideo.load();
          lightboxVideo.hidden = true;
          lightboxImage.hidden = false;
          lightboxImage.src = item.dataset.mediaUrl;
          lightboxImage.alt = item.dataset.mediaLabel || 'Archived tweet media';
        }
        lightboxCount.textContent = `${lightboxIndex + 1} / ${lightboxItems.length}`;
        lightboxPrev.hidden = lightboxItems.length < 2;
        lightboxNext.hidden = lightboxItems.length < 2;
      };
      const stepLightbox = (direction) => {
        lightboxIndex = (lightboxIndex + direction + lightboxItems.length) % lightboxItems.length;
        updateLightbox();
      };
      document.addEventListener('click', (event) => {
        const trigger = event.target.closest('.media-trigger:not(.video-preview), .video-lightbox-trigger');
        if (!trigger) return;
        const gallery = trigger.closest('[data-media-group]');
        lightboxItems = [...gallery.querySelectorAll('.media-trigger:not(.video-preview), .video-lightbox-trigger')];
        lightboxIndex = lightboxItems.indexOf(trigger);
        updateLightbox();
        lightbox.showModal();
      });
      document.addEventListener('error', (event) => {
        const image = event.target;
        if (!(image instanceof HTMLImageElement)) return;
        const trigger = image.closest('.media-trigger');
        if (trigger) {
          trigger.classList.add('media-unavailable');
          trigger.innerHTML = '<span>Media unavailable</span>';
        } else if (image === lightboxImage) {
          lightboxCount.textContent = 'Media unavailable';
        }
      }, true);
      lightboxClose.addEventListener('click', () => lightbox.close());
      lightbox.addEventListener('close', () => { lightboxVideo.pause(); lightboxVideo.removeAttribute('src'); lightboxVideo.load(); });
      lightboxPrev.addEventListener('click', () => stepLightbox(-1));
      lightboxNext.addEventListener('click', () => stepLightbox(1));
      lightbox.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
      document.addEventListener('keydown', (event) => {
        if (!lightbox.open) return;
        if (event.key === 'ArrowLeft') stepLightbox(-1);
        if (event.key === 'ArrowRight') stepLightbox(1);
      });
      themeToggles.forEach((toggle) => toggle.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          localStorage.setItem('theme', theme);
          document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#080908' : '#f4f1e9';
        }));
    </script>
  </body>
</html>
