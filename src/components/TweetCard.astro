---
import TweetText from "./TweetText.astro";
import HugeIcon from "./HugeIcon.astro";
import {
  Bookmark02Icon,
  Comment01Icon,
  FavouriteIcon,
  RepeatIcon,
  Share01Icon,
} from "@hugeicons/core-free-icons";

interface MediaItem {
  type: string;
  url: string;
}

interface UrlItem {
  displayUrl?: string;
  expandedUrl?: string;
}

interface Tweet {
  id: string;
  createdAt: string;
  text: string;
  likeCount: number;
  replyToId?: string | null;
  author: { handle: string; displayName: string; avatarUrl?: string | null; avatarHue: number };
  media: MediaItem[];
  urls: UrlItem[];
  quote?: {
    id: string;
    text: string;
    author: { handle: string; displayName: string };
    media: MediaItem[];
    urls?: UrlItem[];
  } | null;
}

const { tweet } = Astro.props as { tweet: Tweet };
const date = new Date(tweet.createdAt);
const xUrl = `https://x.com/${tweet.author.handle}/status/${tweet.id}`;
const media = tweet.media.filter((item) => item.type === "image").slice(0, 4);
const quoteMedia = (tweet.quote?.media ?? []).filter((item) => item.type === "image").slice(0, 4);
const initials = tweet.author.displayName.trim().slice(0, 2).toUpperCase();
const isLong = tweet.text.length > 700;
const isQuoteLong = (tweet.quote?.text.length ?? 0) > 500;
---

<article class="tweet">
  <div class="avatar" style={`--hue: ${tweet.author.avatarHue}`}>
    {tweet.author.avatarUrl ? <img src={tweet.author.avatarUrl} alt="" /> : initials}
  </div>
  <div class="tweet-body">
    <header class="tweet-header">
      <span class="name">{tweet.author.displayName}</span>
      <a class="handle" href={`https://x.com/${tweet.author.handle}`} target="_blank" rel="noreferrer">@{tweet.author.handle}</a>
      <span class="dot">·</span>
      <time datetime={tweet.createdAt} title={date.toLocaleString()}>{date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</time>
      <a class="tweet-menu" href={xUrl} target="_blank" rel="noreferrer" aria-label="Open original tweet">•••</a>
    </header>
    {tweet.replyToId && <p class="replying">Replying to a moment in the archive</p>}
    <div class:list={["tweet-copy", { collapsed: isLong }]}><p class="tweet-text"><TweetText text={tweet.text} urls={tweet.urls} hasMedia={media.length > 0} /></p></div>
    {isLong && <button class="expand-copy" type="button" aria-expanded="false">Show more</button>}
    {media.length > 0 && <div class:list={["media", `media-count-${media.length}`, { "media-grid": media.length > 1 }]} data-media-group={tweet.id}>
      {media.map((item, index) => <button class="media-trigger" type="button" data-media-url={item.url} data-media-index={index} aria-label={`Open image ${index + 1} of ${media.length}`}><img src={item.url} alt="" loading="lazy" decoding="async" /></button>)}
    </div>}
    {tweet.quote && <div class="quote">
      <a class="quote-source" href={`https://x.com/${tweet.quote.author.handle}/status/${tweet.quote.id}`} target="_blank" rel="noreferrer"><b>{tweet.quote.author.displayName}</b> <span>@{tweet.quote.author.handle}</span></a>
      <div class:list={["quote-copy", { collapsed: isQuoteLong }]}><p><TweetText text={tweet.quote.text} urls={tweet.quote.urls} hasMedia={quoteMedia.length > 0} /></p></div>
      {isQuoteLong && <a class="quote-more" href={`https://x.com/${tweet.quote.author.handle}/status/${tweet.quote.id}`} target="_blank" rel="noreferrer">Read full quoted post ↗</a>}
      {quoteMedia.length > 0 && <div class:list={["quote-media", `media-count-${quoteMedia.length}`, { "media-grid": quoteMedia.length > 1 }]} data-media-group={`quote-${tweet.quote.id}`}>
        {quoteMedia.map((item, index) => <button class="media-trigger" type="button" data-media-url={item.url} data-media-index={index} aria-label={`Open quoted image ${index + 1} of ${quoteMedia.length}`}><img src={item.url} alt="" loading="lazy" decoding="async" /></button>)}
      </div>}
    </div>}
    <footer class="tweet-actions">
      <a class="action" href={xUrl} target="_blank" rel="noreferrer" aria-label="View conversation"><HugeIcon icon={Comment01Icon} size={18} /></a>
      <span class="action" aria-hidden="true"><HugeIcon icon={RepeatIcon} size={18} /></span>
      <span class="action like" aria-label={`${tweet.likeCount.toLocaleString()} likes`}><HugeIcon icon={FavouriteIcon} size={18} /><small>{Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(tweet.likeCount)}</small></span>
      <span class="action" aria-hidden="true"><HugeIcon icon={Bookmark02Icon} size={18} /></span>
      <a class="action" href={xUrl} target="_blank" rel="noreferrer" aria-label="Open original tweet"><HugeIcon icon={Share01Icon} size={18} /></a>
    </footer>
  </div>
</article>
